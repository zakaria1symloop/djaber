{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": { "@api/*": ["src/*"] },
    "types": ["node", "jest"]
  },
  "include": ["src", "test"]
}
