/// D39
model AccountDeletionRequest {
  id            String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId        String         @db.Uuid
  source        DeletionSource
  status        DeletionStatus @default(pending_confirmation)
  tokenHash     String?        @unique
  requestedAt   DateTime       @default(now())
  confirmedAt   DateTime?
  scheduledAt   DateTime?
  blockedReason String?
  exportJobId   String?        @db.Uuid
  cancelledAt   DateTime?
  processedAt   DateTime?
  processedById String?        @db.Uuid
  ip            String?

  user        User  @relation("DeletionUser", fields: [userId], references: [id], onDelete: Cascade)
  exportJob   Job?  @relation(fields: [exportJobId], references: [id])
  processedBy User? @relation("DeletionProcessedBy", fields: [processedById], references: [id])

  // PARTIAL UNIQUE: (userId) WHERE status IN ('pending_confirmation','grace','blocked')
  @@index([status, scheduledAt])
}

/// D21-bis — read-only impersonation session
model ImpersonationSession {
  id              String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  adminUserId     String            @db.Uuid
  workspaceId     String            @db.Uuid
  reason          String            // >= 10 chars; read-only session (D21-bis): every non-GET request => ADMIN_IMPERSONATION_FORBIDDEN_ACTION
  ticketId        String?           @db.Uuid
  startedAt       DateTime          @default(now())
  expiresAt       DateTime          // startedAt + 30 min
  endedAt         DateTime?
  actionsCount    Int               @default(0)

  admin     User           @relation(fields: [adminUserId], references: [id])
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id])
  auditLogs AuditLog[]

  @@index([workspaceId, startedAt])
}

model DataDeletionRequest {
  id                 String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider           String             @default("meta")
  confirmationCode   String             @unique
  externalUserId     String
  status             DataDeletionStatus @default(pending)
  requestedAt        DateTime           @default(now())
  completedAt        DateTime?
  affectedWorkspaces Int                @default(0)
}

