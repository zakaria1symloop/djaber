model Client {
  id              String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String       @db.Uuid
  name            String
  phone           String?
  phone2          String?
  email           String?
  notes           String?
  tags            String[]     @default([])
  source          ClientSource @default(manual)
  isPlaceholder   Boolean      @default(false)
  orderCount      Int          @default(0)
  totalSpent      Int          @default(0)
  lastOrderAt     DateTime?
  returnCount     Int          @default(0)
  cancelCount     Int          @default(0)
  uncollectedCount Int         @default(0)
  riskLevel       RiskLevel    @default(normal)
  riskSetManually Boolean      @default(false)
  mergedIntoId    String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mergedInto    Client?          @relation("ClientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom    Client[]         @relation("ClientMerge")
  addresses     ClientAddress[]
  identities    ClientIdentity[]
  conversations Conversation[]
  orders        Order[]
  sales         Sale[]
  blocks        CustomerBlock[]
  reports       Report[]

  // PARTIAL UNIQUE: (workspaceId, phone) WHERE deletedAt IS NULL AND phone IS NOT NULL
  @@index([workspaceId, lastOrderAt])
  @@index([workspaceId, riskLevel])
}

model ClientAddress {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  clientId    String   @db.Uuid
  wilayaId    Int
  communeId   Int?
  communeText String?
  address     String?
  isStopdesk  Boolean  @default(false)
  stopdeskId  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  wilaya  Wilaya   @relation(fields: [wilayaId], references: [id])
  commune Commune? @relation(fields: [communeId], references: [id])

  @@index([clientId])
}

model ClientIdentity {
  id               String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  clientId         String  @db.Uuid
  channelId        String  @db.Uuid
  externalSenderId String
  displayName      String?
  avatarUrl        String?

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalSenderId])
  @@index([clientId])
}

// =============================================================================
// 7. ORDERS & DELIVERY
// =============================================================================

model Order {
  id                 String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId        String             @db.Uuid
  number             String
  clientId           String             @db.Uuid
  conversationId     String?            @db.Uuid
  channelId          String?            @db.Uuid
  source             OrderSource
  agentId            String?            @db.Uuid
  createdById        String?            @db.Uuid
  apiKeyId           String?            @db.Uuid
  importJobId        String?            @db.Uuid
  assigneeId         String?            @db.Uuid
  status             OrderStatus        @default(new)
  confirmationStatus ConfirmationStatus @default(pending)
  callbackAt         DateTime?
  paymentStatus      PaymentStatus      @default(unpaid)
  deliveryStatus     DeliveryStatus     @default(not_sent)
  paymentMethod      PaymentMethod      @default(cash)
  clientName         String
  clientPhone        String
  clientPhone2       String?
  wilayaId           Int?
  communeId          Int?
  communeText        String?
  address            String?
  isStopdesk         Boolean            @default(false)
  stopdeskId         String?
  subtotal           Int
  discount           Int                @default(0)
  tax                Int                @default(0)
  deliveryFee        Int                @default(0)
  courierCost        Int?
  returnFee          Int?
  total              Int
  amountPaid         Int                @default(0)
  callAttempts       Int                @default(0)
  riskLevel          RiskLevel          @default(normal)
  notes              String?
  labelPrintedAt     DateTime?
  orderedAt          DateTime           @default(now())
  confirmedAt        DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       CancelReason?
  cancelNote         String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id])
  conversation Conversation?        @relation(fields: [conversationId], references: [id])
  channel      Channel?             @relation(fields: [channelId], references: [id])
  agent        Agent?               @relation(fields: [agentId], references: [id])
  createdBy    User?                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  apiKey       ApiKey?              @relation(fields: [apiKeyId], references: [id])
  importJob    Job?                 @relation("OrderImportJob", fields: [importJobId], references: [id])
  assignee     User?                @relation("OrderAssignee", fields: [assigneeId], references: [id])
  wilaya       Wilaya?              @relation(fields: [wilayaId], references: [id])
  commune      Commune?             @relation(fields: [communeId], references: [id])
  items        OrderItem[]
  history      OrderStatusHistory[]
  calls        OrderCall[]
  orderNotes   OrderNote[]
  payments     OrderPayment[]
  shipments    Shipment[]
  sheetsRow    SheetsRow?
  recoEvents   RecommendationEvent[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status, orderedAt])
  @@index([workspaceId, source, agentId])
  @@index([workspaceId, assigneeId, status])
  @@index([workspaceId, callbackAt])
  @@index([workspaceId, clientId])
  @@index([workspaceId, deliveryStatus])
}

model OrderItem {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  variantId   String? @db.Uuid
  productName String
  variantName String?
  sku         String?
  unitPrice   Int
  costPrice   Int?
  quantity    Int
  discount    Int     @default(0)
  total       Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId     String    @db.Uuid
  field       String
  from        String?
  to          String
  actorType   ActorType
  actorId     String?   @db.Uuid
  reason      String?
  effectiveAt DateTime?
  at          DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
}

model OrderCall {
  id         String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId    String     @db.Uuid
  userId     String     @db.Uuid
  result     CallResult
  callbackAt DateTime?
  notes      String?
  calledAt   DateTime   @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId, calledAt])
}

model OrderNote {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId   String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([orderId])
}

/// one row per recorded payment (order / sale / purchase)
model PaymentEntry {
  id                String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String            @db.Uuid
  sourceType        PaymentSourceType
  sourceId          String            @db.Uuid
  amount            Int
  method            PaymentMethod
  reference         String?
  note              String?
  paidAt            DateTime          @default(now())
  createdById       String            @db.Uuid
  cashTransactionId String?           @unique @db.Uuid
  createdAt         DateTime          @default(now())

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User             @relation(fields: [createdById], references: [id])
  cashTransaction CashTransaction? @relation(fields: [cashTransactionId], references: [id])

  @@index([workspaceId, sourceType, sourceId])
}

model OrderPayment {
  id           String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId  String              @db.Uuid
  orderId      String              @db.Uuid
  provider     String              @default("chargily")
  amount       Int
  status       OnlinePaymentStatus @default(pending)
  checkoutUrl  String?
  providerRef  String?             @unique
  expiresAt    DateTime?
  paidAt       DateTime?
  refundReason String?
  refundedAt   DateTime?
  raw          Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model Wilaya {
  id     Int    @id
  code   String @unique
  nameFr String
  nameAr String

  communes        Commune[]
  workspaces      Workspace[]
  clientAddresses ClientAddress[]
  orders          Order[]
  feeRules        DeliveryFeeRule[]
  rateCaches      CourierRateCache[]
  courierAccounts CourierAccount[]
}

model Commune {
  id         Int     @id
  wilayaId   Int
  nameFr     String
  nameAr     String
  postalCode String?

  wilaya          Wilaya             @relation(fields: [wilayaId], references: [id])
  clientAddresses ClientAddress[]
  orders          Order[]
  courierMaps     CourierCommuneMap[]
  stopdesks       CourierStopdesk[]

  @@index([wilayaId])
}

model CourierCommuneMap {
  id           String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider     CourierProvider
  communeId    Int
  externalCode String
  stopdeskIds  Json?

  commune Commune @relation(fields: [communeId], references: [id])

  @@unique([provider, communeId])
}

model CourierStopdesk {
  id         String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider   CourierProvider
  communeId  Int
  externalId String
  name       String
  address    String?

  commune Commune @relation(fields: [communeId], references: [id])

  @@unique([provider, externalId])
  @@index([provider, communeId])
}

model DeliveryFeeRule {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String    @db.Uuid
  wilayaId      Int
  homePrice     Int
  stopdeskPrice Int
  returnPrice   Int       @default(0)
  freeAbove     Int?      // free home delivery above this order total (DA); null => Workspace.freeDeliveryThreshold
  isActive      Boolean   @default(true)
  source        FeeSource @default(default)
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wilaya    Wilaya    @relation(fields: [wilayaId], references: [id])

  @@unique([workspaceId, wilayaId])
}

model CourierAccount {
  id                 String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId        String          @db.Uuid
  provider           CourierProvider
  baseUrl            String          @default("")
  displayName        String
  credentials        Bytes
  isActive           Boolean         @default(true)
  isDefault          Boolean         @default(false)
  senderName         String?
  senderPhone        String?
  senderAddress      String?
  senderWilayaId     Int?
  webhookSecret      Bytes?
  lastTestedAt       DateTime?
  lastTestOk         Boolean?
  lastTestLatencyMs  Int?
  lastTestError      String?         // COURIER_CREDENTIALS_INVALID | COURIER_UNAVAILABLE of the last failed test
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace     Workspace          @relation("CourierWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  senderWilaya  Wilaya?            @relation(fields: [senderWilayaId], references: [id])
  defaultOf     Workspace?         @relation("WorkspaceDefaultCourier")
  shipments     Shipment[]
  rateCaches    CourierRateCache[]

  @@unique([workspaceId, provider, baseUrl])
}

model CourierRateCache {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  courierAccountId String   @db.Uuid
  wilayaId         Int
  homePrice        Int?
  stopdeskPrice    Int?
  avgDays          Decimal? @db.Decimal(4, 1)
  fetchedAt        DateTime @default(now())

  courierAccount CourierAccount @relation(fields: [courierAccountId], references: [id], onDelete: Cascade)
  wilaya         Wilaya         @relation(fields: [wilayaId], references: [id])

  @@unique([courierAccountId, wilayaId])
}

model Shipment {
  id                  String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId         String           @db.Uuid
  orderId             String           @db.Uuid
  provider            ShipmentProvider
  courierAccountId    String?          @db.Uuid
  status              ShipmentStatus   @default(pending)
  trackingNumber      String?
  externalId          String?
  labelUrl            String?
  publicTrackingToken String           @unique
  codAmount           Int
  weightKg            Decimal?         @db.Decimal(6, 2)
  contentSummary      String?
  stopdeskId          String?
  courierCost         Int?
  failureReason       FailureReason?
  deliveryAttempts    Int              @default(0)
  rawStatus           String?
  lastEventAt         DateTime?        // last courier / manual event (creation until then) — "Sans mouvement", stale at 30 d
  lastSyncedAt        DateTime?
  nextSyncAt          DateTime?
  attempts            Int              @default(0)
  lastError           String?
  cancelledAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierAccount CourierAccount? @relation(fields: [courierAccountId], references: [id])
  events         ShipmentEvent[]

  // PARTIAL UNIQUE: (orderId) WHERE status NOT IN ('cancelled','failed','returned','stale')
  @@index([workspaceId, status, lastSyncedAt])
  @@index([nextSyncAt])
  @@index([workspaceId, lastEventAt])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id           String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  shipmentId   String              @db.Uuid
  rawStatus    String
  mappedStatus ShipmentStatus?
  description  String?
  location     String?
  at           DateTime
  source       ShipmentEventSource
  actorId      String?             @db.Uuid
  createdAt    DateTime            @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id])

  @@index([shipmentId, at])
}

model SheetsConnection {
  id            String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String       @unique @db.Uuid
  googleEmail   String
  refreshToken  Bytes
  spreadsheetId String
  sheetName     String       @default("Commandes")
  filters       Json         @default("{}")
  status        SheetsStatus @default(active)
  lastSyncAt    DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rows      SheetsRow[]
}

model SheetsRow {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  connectionId String   @db.Uuid
  orderId      String   @unique @db.Uuid
  syncedAt     DateTime @default(now())

  connection SheetsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

