model Supplier {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId      String    @db.Uuid
  name             String
  email            String?
  phone            String?
  address          String?
  notes            String?
  terms            String?
  paymentTermsDays Int?
  avgLeadDays      Int?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchases  Purchase[]
  stockRecos StockRecommendation[]

  @@index([workspaceId, isActive])
}

model Purchase {
  id                 String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId        String           @db.Uuid
  number             String
  supplierId         String?          @db.Uuid
  status             PurchaseStatus   @default(draft)
  supplierInvoiceRef String?
  subtotal           Int              @default(0)
  tax                Int              @default(0)
  shippingCost       Int              @default(0)
  total              Int              @default(0)
  amountPaid         Int              @default(0)
  paymentMethod      PaymentMethod?
  paymentStatus      GdsPaymentStatus @default(unpaid)
  notes              String?
  cancelReason       String?
  createdById        String           @db.Uuid
  purchasedAt        DateTime         @default(now())
  expectedAt         DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier  Supplier?      @relation(fields: [supplierId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status, expectedAt])
}

model PurchaseItem {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  purchaseId  String  @db.Uuid
  productId   String  @db.Uuid
  variantId   String? @db.Uuid
  productName String
  variantName String?
  quantity    Int
  receivedQty Int     @default(0)
  unitCost    Int
  total       Int

  purchase Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([purchaseId])
}

model Sale {
  id            String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String           @db.Uuid
  number        String
  clientId      String?          @db.Uuid
  customerName  String?
  customerPhone String?
  status        SaleStatus       @default(completed)
  subtotal      Int
  discount      Int              @default(0)
  tax           Int              @default(0)
  total         Int
  amountPaid    Int              @default(0)
  paymentMethod PaymentMethod    @default(cash)
  paymentStatus GdsPaymentStatus @default(unpaid)
  notes         String?
  createdById   String           @db.Uuid
  soldAt        DateTime         @default(now())
  cancelledAt   DateTime?
  cancelledById String?          @db.Uuid
  cancelReason  String?
  stockRestored Boolean?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client?    @relation(fields: [clientId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])
  cancelledBy User?      @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  items       SaleItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, soldAt])
