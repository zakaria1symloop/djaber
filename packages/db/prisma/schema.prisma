  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  owner                User?                   @relation("WorkspaceOwner")
  senderWilaya         Wilaya?                 @relation(fields: [senderWilayaId], references: [id])
  defaultCourier       CourierAccount?         @relation("WorkspaceDefaultCourier", fields: [defaultCourierAccountId], references: [id])
  trustSetBy           User?                   @relation("WorkspaceTrustSetBy", fields: [trustSetById], references: [id])
  memberships          Membership[]
  invitations          Invitation[]
  idempotencyKeys      IdempotencyKey[]
  subscriptions        Subscription[]
  invoices             Invoice[]
  billingPayments      BillingPayment[]
  creditLedger         CreditLedger[]
  packPurchases        CreditPackPurchase[]
  promoRedemptions     PromoRedemption[]
  promoCodesTargeted   PromoCode[]             @relation("PromoTargetWorkspace")
  channels             Channel[]
  channelEvents        ChannelEvent[]
  conversations        Conversation[]
  messages             Message[]
  conversationNotes    ConversationNote[]
  quickReplies         QuickReply[]
  agents               Agent[]
  agentVersions        AgentVersion[]
  agentInsights        AgentInsight[]
  aiRuns               AiRun[]
  agentTestRuns        AgentTestRun[]
  agentTestLinks       AgentTestLink[]
  agentFaqs            AgentFaq[]
  categories           Category[]
  units                Unit[]
  products             Product[]
  productVariants      ProductVariant[]
  productExpenses      ProductExpense[]
  recommendations      Recommendation[]
  stockMovements       StockMovement[]
  inventoryCounts      InventoryCount[]
  stockRecommendations StockRecommendation[]
  stockRecoMutes       StockRecommendationMute[]
  clients              Client[]
  orders               Order[]
  paymentEntries       PaymentEntry[]
  orderPayments        OrderPayment[]
  deliveryFeeRules     DeliveryFeeRule[]
  courierAccounts      CourierAccount[]        @relation("CourierWorkspace")
  shipments            Shipment[]
  sheetsConnection     SheetsConnection?
  suppliers            Supplier[]
  purchases            Purchase[]
  sales                Sale[]
  cashTransactions     CashTransaction[]
  cashClosings         CashClosing[]
  notifications        Notification[]
  uploads              Upload[]
  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  jobs                 Job[]
  counters             Counter[]
  savedViews           SavedView[]
  dailyStats           DailyStat[]
  reportSchedules      ReportSchedule[]
  moderationItems      ModerationItem[]
  moderationAppeals    ModerationAppeal[]
  reports              Report[]                @relation("ReportWorkspace")
  reportsTargeted      Report[]                @relation("ReportTargetWorkspace")
  customerBlocks       CustomerBlock[]
  blockedWordRows      BlockedWord[]
  supportTickets       SupportTicket[]
  impersonations       ImpersonationSession[]
  featureFlagOverrides FeatureFlagOverride[]
}

model Membership {
  id          String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String     @db.Uuid
  userId      String     @db.Uuid
  role        MemberRole
  readOnly    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences NotificationPreference[]

  @@unique([workspaceId, userId])
  // PARTIAL UNIQUE: (workspaceId) WHERE role = 'owner'  (D30)
  @@index([userId])
}

model Invitation {
  id          String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String     @db.Uuid
  email       String
  role        MemberRole
  tokenHash   String     @unique
  invitedById String     @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  lastSentAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([workspaceId, email])
}

model DeviceToken {
  id         String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  deviceName String?
  locale     Locale?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IdempotencyKey {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId  String   @db.Uuid
  key          String
  actorKey     String
  requestHash  String
  responseCode Int
  responseBody Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([expiresAt])
}

/// D41
model PlatformInvitation {
  id           String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email        String
  platformRole PlatformRole
  tokenHash    String       @unique
  invitedById  String       @db.Uuid
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())

  invitedBy User @relation("PlatformInviteInviter", fields: [invitedById], references: [id])
}

/// D39
model LegalAcceptance {
  id              String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId          String         @db.Uuid
  legalDocumentId String         @db.Uuid
  version         Int
  acceptedAt      DateTime       @default(now())
  ip              String?
  client          DevicePlatform

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [legalDocumentId], references: [id])

  @@unique([userId, legalDocumentId, version])
}

// =============================================================================
// 2. BILLING
// =============================================================================

model Plan {
  id                       String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug                     String    @unique
  name                     Json
  description              Json
  priceMonthly             Int
  priceYearly              Int
  trialDays                Int       @default(14)
  maxPages                 Int
  maxAgents                Int
  maxProducts              Int
  maxConversationsPerMonth Int
  maxMembers               Int
  maxApiKeys               Int       @default(0)
  maxWebhooks              Int       @default(0)
  syncHistoryDays          Int       @default(30)
  monthlyCredits           Int
  features                 String[]  @default([])
  providerPriceIds         Json?
  isActive                 Boolean   @default(true)
  isFeatured               Boolean   @default(false)
  isVisible                Boolean   @default(true)
  sortOrder                Int       @default(0)
  version                  Int       @default(1)
  archivedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  versions      PlanVersion[]
  subscriptions Subscription[]
}

model PlanVersion {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  planId      String   @db.Uuid
  version     Int
  snapshot    Json
  changedById String   @db.Uuid
  impactCount Int      @default(0)
  createdAt   DateTime @default(now())

  plan      Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@unique([planId, version])
}

model Subscription {
  id                     String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId            String             @db.Uuid
  planId                 String             @db.Uuid
  planVersion            Int                @default(1)
  status                 SubscriptionStatus
  billingCycle           BillingCycle
  provider               BillingProvider    @default(none)
  appliedPrice           Int                @default(0)
  discountPct            Int?
  promoRedemptionId      String?            @unique @db.Uuid
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  cancelReason           String?
  dunningStage           DunningStage?
  providerSubscriptionId String?
  providerCustomerId     String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan            Plan             @relation(fields: [planId], references: [id])
  promoRedemption PromoRedemption? @relation(fields: [promoRedemptionId], references: [id])
  invoices        Invoice[]
  payments        BillingPayment[]

  // PARTIAL UNIQUE: (workspaceId) WHERE status IN ('trial','active','dunning')
  @@index([workspaceId, status])
  @@index([currentPeriodEnd])
}

model Invoice {
  id                   String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId          String                @db.Uuid
  number               String                @unique
  kind                 InvoiceKind
  subscriptionId       String?               @db.Uuid
  creditPackPurchaseId String?               @unique @db.Uuid
  amount               Int
  status               InvoiceStatus
  method               PaymentMethodBilling?
  dueAt                DateTime?
  paidAt               DateTime?
  pdfUrl               String?
  lines                Json
  billingInfo          Json?
  dunningStage         DunningStage?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription?       @relation(fields: [subscriptionId], references: [id])
  packPurchase CreditPackPurchase? @relation(fields: [creditPackPurchaseId], references: [id])
  payments     BillingPayment[]

  @@index([workspaceId, status, createdAt])
}

model BillingPayment {
  id                 String                 @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId        String                 @db.Uuid
  invoiceId          String?                @db.Uuid
  subscriptionId     String?                @db.Uuid
  amount             Int
  status             BillingPaymentStatus
  provider           BillingPaymentProvider
  providerCheckoutId String                 @unique
  reference          String?
  proofUploadId      String?                @db.Uuid
  recordedById       String?                @db.Uuid
  paidAt             DateTime?
  raw                Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  proof        Upload?       @relation(fields: [proofUploadId], references: [id])
  recordedBy   User?         @relation("BillingPaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([workspaceId, createdAt])
}

model CreditLedger {
  id                   String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId          String       @db.Uuid
  periodStart          DateTime?
  bucket               CreditBucket @default(plan) // D40
  action               CreditAction
  kind                 CreditKind
  credits              Int
  balanceAfter         Int
  aiRunId              String?      @db.Uuid
  conversationId       String?      @db.Uuid
  agentId              String?      @db.Uuid
  channelId            String?      @db.Uuid
  creditPackPurchaseId String?      @db.Uuid
  grantedById          String?      @db.Uuid
  reason               String?
  idempotencyKey       String       @unique
  createdAt            DateTime     @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiRun        AiRun?              @relation(fields: [aiRunId], references: [id])
  packPurchase CreditPackPurchase? @relation(fields: [creditPackPurchaseId], references: [id])
  grantedBy    User?               @relation("CreditGrantedBy", fields: [grantedById], references: [id])
  promoRedemption PromoRedemption?

  @@index([workspaceId, periodStart, kind])
  @@index([workspaceId, createdAt])
}

/// D40
model CreditPack {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug            String   @unique
  name            Json
  credits         Int
  priceWebDzd     Int
  googleProductId String?  @unique
  appleProductId  String?  @unique
  storeTier       String?
  storePriceLabel String?
  isActive        Boolean  @default(true)
  visibleWeb      Boolean  @default(true)
  visibleMobile   Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchases CreditPackPurchase[]
}

/// D40
model CreditPackPurchase {
  id                 String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId        String             @db.Uuid
  creditPackId       String             @db.Uuid
  channel            PurchaseChannel
  status             PackPurchaseStatus @default(pending)
  amount             Int
  currency           String             @default("DZD")
  providerCheckoutId String?            @unique
  storeTransactionId String?            @unique
  storeOrderId       String?
  receipt            Json?
  purchasedById      String             @db.Uuid
  validatedAt        DateTime?
  creditedAt         DateTime?
  refundedAt         DateTime?
  refundSource       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pack        CreditPack     @relation(fields: [creditPackId], references: [id])
  purchasedBy User           @relation(fields: [purchasedById], references: [id])
  invoice     Invoice?
  ledgerRows  CreditLedger[]

  @@index([workspaceId, createdAt])
}

model PromoCode {
  id                 String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code               String      @unique
  kind               PromoKind
  value              Int
  periods            Int?
  planSlugs          String[]    @default([])
  target             PromoTarget @default(all)
  targetWorkspaceId  String?     @db.Uuid
  maxUses            Int?
  perWorkspaceLimit  Int         @default(1)
  validFrom          DateTime?
  validTo            DateTime?
  isActive           Boolean     @default(true)
  createdById        String      @db.Uuid
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  targetWorkspace Workspace?        @relation("PromoTargetWorkspace", fields: [targetWorkspaceId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id])
  redemptions     PromoRedemption[]
}

model PromoRedemption {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  promoCodeId   String   @db.Uuid
  workspaceId   String   @db.Uuid
  userId        String   @db.Uuid
  ledgerEntryId String?  @unique @db.Uuid
  redeemedAt    DateTime @default(now())

  promoCode    PromoCode     @relation(fields: [promoCodeId], references: [id])
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  ledgerEntry  CreditLedger? @relation(fields: [ledgerEntryId], references: [id])
  subscription Subscription?

  @@unique([promoCodeId, workspaceId])
}

// =============================================================================
// 3. CHANNELS & CONVERSATIONS
// =============================================================================

model Channel {
  id              String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String          @db.Uuid
  platform        ChannelPlatform
  externalId      String
  name            String
  avatarUrl       String?
  followersCount  Int?
  accessToken     Bytes?
  tokenExpiresAt  DateTime?
  status          ChannelStatus   @default(active)
  pausedReason    PausedReason?
  parentChannelId String?         @db.Uuid
  connectedById   String          @db.Uuid
  icebreaker      String?
  grantedScopes   String[]        @default([])
  webhookSubscribed Boolean       @default(true) // false after PAGE_WEBHOOK_SUBSCRIBE_FAILED; retried by sched-channel-webhook-retry (05-integrations §1.5)
  lastSyncAt      DateTime?
  lastInfoSyncAt  DateTime?
  lastSeenAt      DateTime?
  lastTokenCheckAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        Channel?          @relation("ChannelParent", fields: [parentChannelId], references: [id])
  children      Channel[]         @relation("ChannelParent")
  connectedBy   User              @relation("ChannelConnectedBy", fields: [connectedById], references: [id])
  events        ChannelEvent[]
  conversations Conversation[]
  agentChannels AgentChannel[]
  identities    ClientIdentity[]
  orders        Order[]
  blocks        CustomerBlock[]

  @@unique([platform, externalId])
  @@index([workspaceId, status])
}

model ChannelEvent {
  id          String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String           @db.Uuid
  channelId   String           @db.Uuid
  kind        ChannelEventKind
  description String?
  actorType   ActorType
  actorId     String?          @db.Uuid
  at          DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([channelId, at])
}

model Conversation {
  id                    String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId           String             @db.Uuid
  channelId             String             @db.Uuid
  externalSenderId      String
  clientId              String?            @db.Uuid
  agentId               String?            @db.Uuid
  assigneeId            String?            @db.Uuid
  status                ConversationStatus @default(active)
  aiPaused              Boolean            @default(false)
  unreadCount           Int                @default(0)
  lastMessageAt         DateTime?
  lastCustomerMessageAt DateTime?
  lastMessagePreview    String?
  lastAiIntent          AiIntent?
  firstInboundAt        DateTime?
  context               Json               @default("{}")
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  client    Client?            @relation(fields: [clientId], references: [id])
  agent     Agent?             @relation(fields: [agentId], references: [id])
  assignee  User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  messages  Message[]
  notes     ConversationNote[]
  insights  AgentInsight[]
  aiRuns    AiRun[]
  orders    Order[]
  recoEvents RecommendationEvent[]
  reports   Report[]

  @@unique([channelId, externalSenderId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, clientId])
}

model Message {
  id                  String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId         String                @db.Uuid
  conversationId      String                @db.Uuid
  externalId          String?
  direction           MessageDirection
  type                MessageType           @default(text)
  author              MessageAuthor
  authorUserId        String?               @db.Uuid
  text                String?
  attachments         Json?
  transcript          String?
  transcriptStatus    TranscriptStatus?
  payload             Json?
  customerReaction    CustomerReaction? // DECIDED
  containsBlockedWord Boolean               @default(false)
  sentAt              DateTime              @default(now())
  deliveryStatus      MessageDeliveryStatus @default(sent)
  error               String?
  aiRunId             String?               @db.Uuid
  createdAt           DateTime              @default(now())

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?          @relation("MessageAuthorUser", fields: [authorUserId], references: [id])
  aiRun        AiRun?         @relation(fields: [aiRunId], references: [id])
  insights     AgentInsight[]
  reports      Report[]

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
}

model ConversationNote {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId    String   @db.Uuid
  conversationId String   @db.Uuid
  authorId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([conversationId])
}

model QuickReply {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String   @db.Uuid
  title       String   @db.VarChar(80)
  body        String   @db.VarChar(1000)
  shortcut    String?  @db.VarChar(30) // "/livr" — Figma DLG Settings "Réponse rapide" (RACCOURCI), inbox "/" popover
  locale      Locale   @default(fr)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, locale, title])
  @@index([workspaceId, sortOrder])
}

model InboundEvent {
  id          String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider    InboundProvider
  externalId  String          @unique
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  error       String?

  @@index([provider, receivedAt])
}

// =============================================================================
// 4. AI
// =============================================================================

model AiProvider {
  id           String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key          AiProviderKey @unique
  displayName  String
  apiKey       Bytes?
  isActive     Boolean       @default(false)
  isPrimary    Boolean       @default(false)
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  keyAddedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  models AiModel[]
  aiRuns AiRun[]
}

model AiModel {
  id                   String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  providerId           String         @db.Uuid
  modelId              String
  displayName          String
  capabilities         AiCapability[]
  supportsTools        Boolean        @default(true)
  inputPricePerM       Decimal        @db.Decimal(10, 4) // USD per 1M tokens
  outputPricePerM      Decimal        @db.Decimal(10, 4)
  contextTokens        Int?
  timeoutSec           Int            @default(20)
  failoverThresholdPct Int            @default(2)
  isActive             Boolean        @default(true)
  isDefault            Boolean        @default(false)
  isFallbackText       Boolean        @default(false)
  isFallbackVision     Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  provider       AiProvider @relation(fields: [providerId], references: [id])
  agents         Agent[]
  aiRuns         AiRun[]
  primaryRoutes  AiRoute[]  @relation("RoutePrimary")
  fallbackRoutes AiRoute[]  @relation("RouteFallback")

  @@unique([providerId, modelId])
}

model AiRoute {
  id                String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  capability        AiCapability @unique
  primaryModelId    String       @db.Uuid
  fallbackModelId   String?      @db.Uuid
  creditCost        Int
  timeoutSec        Int          @default(20)
  errorThresholdPct Int          @default(2)
  failoverActive    Boolean      @default(false)
  failoverSince     DateTime?
  updatedById       String       @db.Uuid
  updatedAt         DateTime     @updatedAt

  primaryModel  AiModel  @relation("RoutePrimary", fields: [primaryModelId], references: [id])
  fallbackModel AiModel? @relation("RouteFallback", fields: [fallbackModelId], references: [id])
  updatedBy     User     @relation(fields: [updatedById], references: [id])
}

/// versioned credit pricing grid (ADM-06)
model CreditPricing {
  id                   String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  version              Int      @unique
  usdToDzd             Decimal  @db.Decimal(10, 2)
  creditPriceDzd       Decimal  @db.Decimal(10, 2)
  costs                Json // { text:1, image:5, voice:3, order:0 }
  avgTokensPerMessage  Int?
  targetMarginPct      Int?
  effectiveAt          DateTime
  createdById          String   @db.Uuid
  announcementCmsEntryId String? @db.Uuid
  createdAt            DateTime @default(now())

  createdBy    User      @relation(fields: [createdById], references: [id])
  announcement CmsEntry? @relation(fields: [announcementCmsEntryId], references: [id])
}

model AgentPreset {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key            String       @unique
  name           Json
  tagline        Json?
  description    Json?
  badge          PresetBadge?
  sectors        String[]     @default([])
  status         PresetStatus @default(draft)
  currentVersion Int          @default(0)
  sortOrder      Int          @default(0)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  versions AgentPresetVersion[]
  agents   Agent[]
}

model AgentPresetVersion {
  id            String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  presetId      String       @db.Uuid
  version       Int
  status        PresetStatus @default(draft)
  locales       Json // { fr|ar|en: { name, tagline, systemPrompt } }
  config        Json
  changelog     String?
  testResults   Json?
  publishedAt   DateTime?
  publishedById String?      @db.Uuid
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  preset      AgentPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  publishedBy User?       @relation(fields: [publishedById], references: [id])

  @@unique([presetId, version])
}

model Agent {
  id                  String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId         String        @db.Uuid
  name                String
  description         String?
  personality         Personality   @default(friendly)
  customInstructions  String        @default("")
  productCardTemplate String?
  closingInstructions String?
  humanHandoffRules   String?
  modelId             String        @db.Uuid
  temperature         Decimal       @default(0.6) @db.Decimal(3, 2)
  maxTokens           Int           @default(1200)
  sellAllProducts     Boolean       @default(true)
  imageRecognition    Boolean       @default(true)
  voiceTranscription  Boolean       @default(true)
  responseDelaySec    Int           @default(3)
  isActive            Boolean       @default(false)
  pausedReason        PausedReason?
  status              AgentStatus   @default(draft)
  presetId            String?       @db.Uuid
  presetVersion       Int?
  currentVersion      Int           @default(0)
  lastActiveAt        DateTime?
  scheduledActivateAt DateTime?
  wizardStep          Int?
  version             Int           @default(1)
  // --- 05 §15 wizard fields (D54; compiled into customInstructions / humanHandoffRules at save) ---
  displayName         String?
  avatarUploadId      String?       @db.Uuid
  avatarMode          String?       // page | upload | initials
  languages           String[]      @default([])
  defaultLanguage     String?
  tone                AgentTone?
  formality           Formality?
  emojiLevel          EmojiLevel?
  catalogScope        CatalogScope  @default(all)
  scopeCategoryIds    String[]      @default([])
  outOfStockBehavior  OutOfStockBehavior @default(suggest_alternative)
  showMissingVariants Boolean       @default(true)
  policies            Json?
  capabilities        Json?
  orderFields         Json?
  maxQtyPerOrder      Int?
  maxAmountPerOrder   Int?
  riskyClientBehavior RiskyClientBehavior?
  recapMode           RecapMode?
  handoffRules        Json?
  handoffKeywords     String[]      @default([])
  businessHours       Json?         // {days: [0-6], from: "HH:mm", to: "HH:mm"}; outside => workspace system message out_of_hours (D43)
  // ---
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  model         AiModel         @relation(fields: [modelId], references: [id])
  preset        AgentPreset?    @relation(fields: [presetId], references: [id])
  avatar        Upload?         @relation("AgentAvatar", fields: [avatarUploadId], references: [id])
  versions      AgentVersion[]
  channels      AgentChannel[]
  products      AgentProduct[]
  insights      AgentInsight[]
  aiRuns        AiRun[]
  testRuns      AgentTestRun[]
  testLinks     AgentTestLink[]
  faqs          AgentFaq[]
  conversations Conversation[]
  orders        Order[]
  moderationItems ModerationItem[]
  stockRecos    StockRecommendation[]

  @@index([workspaceId, status])
}

model AgentVersion {
  id                  String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId         String             @db.Uuid
  agentId             String             @db.Uuid
  version             Int
  snapshot            Json
  note                String?
  createdById         String             @db.Uuid
  source              AgentVersionSource @default(manual)
  restoredFromVersion Int?
  createdAt           DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User      @relation("AgentVersionCreatedBy", fields: [createdById], references: [id])

  @@unique([agentId, version])
}

model AgentChannel {
  agentId   String   @db.Uuid
  channelId String   @unique @db.Uuid
  createdAt DateTime @default(now())

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([agentId, channelId])
}

model AgentProduct {
  agentId   String @db.Uuid
  productId String @db.Uuid

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([agentId, productId])
  @@index([productId])
}

model AgentInsight {
  id              String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String             @db.Uuid
  agentId         String             @db.Uuid
  conversationId  String             @db.Uuid
  messageId       String?            @db.Uuid
  aiRunId         String?            @db.Uuid
  type            InsightType
  customerMessage String
  aiResponse      String?
  detail          String?
  topicKey        String?
  status          InsightStatus      @default(pending)
  resolution      InsightResolution?
  resolvedById    String?            @db.Uuid
  resolvedAt      DateTime?
  snoozedUntil    DateTime?
  createdAt       DateTime           @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id])
  aiRun        AiRun?       @relation(fields: [aiRunId], references: [id])
  resolvedBy   User?        @relation("InsightResolvedBy", fields: [resolvedById], references: [id])

  @@index([workspaceId, agentId, status, topicKey])
}

model AiRun {
  id             String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId    String      @db.Uuid
  agentId        String?     @db.Uuid
  conversationId String?     @db.Uuid
  kind           AiRunKind
  modelId        String      @db.Uuid
  providerId     String      @db.Uuid
  usedFallback   Boolean     @default(false)
  status         AiRunStatus @default(running)
  intent         AiIntent?
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  latencyMs      Int?
  confidence     Decimal?    @db.Decimal(3, 2)
  creditsCharged Int         @default(0)
  toolCallCount  Int         @default(0)
  error          String?
  attempt        Int         @default(1)
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  /// 04-ai-pipeline §5: a reply run is idempotent on (conversationId, batchKey); playground runs carry the session id
  batchKey       String?
  /// e.g. blocked_word, reaped, outside_window
  flags          String[]    @default([])
  /// 04-ai-pipeline §13 run metrics: { language, toolNames[], cardsSent, handoff, costUsd, plannedCost, vision, … }
  meta           Json?

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent        Agent?         @relation(fields: [agentId], references: [id])
  conversation Conversation?  @relation(fields: [conversationId], references: [id])
  model        AiModel        @relation(fields: [modelId], references: [id])
  provider     AiProvider     @relation(fields: [providerId], references: [id])
  toolCalls    AiToolCall[]
  messages     Message[]
  ledgerRows   CreditLedger[]
  insights     AgentInsight[]
  testRuns     AgentTestRun[]
  reports      Report[]

  @@unique([conversationId, batchKey])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, agentId, startedAt])
  @@index([status, startedAt])
}

model AiToolCall {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  aiRunId    String    @db.Uuid
  callId     String
  name       String
  args       Json
  result     Json?
  executedAt DateTime?

  aiRun AiRun @relation(fields: [aiRunId], references: [id], onDelete: Cascade)

  @@unique([aiRunId, callId])
}

/// AGT-02 step 5 scenarios
model AgentTestRun {
  id           String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId  String          @db.Uuid
  agentId      String          @db.Uuid
  agentVersion Int
  scenarioKey  TestScenarioKey
  status       TestRunStatus
  summary      String?
  aiRunId      String?         @db.Uuid
  at           DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  aiRun     AiRun?    @relation(fields: [aiRunId], references: [id])

  @@index([agentId, at])
}

/// shared playground link
model AgentTestLink {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String   @db.Uuid
  agentId     String   @db.Uuid
  tokenHash   String   @unique
  createdById String   @db.Uuid
  expiresAt   DateTime
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])
}

/// AGT-02 step 2 FAQ
model AgentFaq {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String    @db.Uuid
  agentId     String    @db.Uuid
  question    String
  answer      String
  source      FaqSource @default(manual)
  askedCount  Int?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, sortOrder])
}

// =============================================================================
// 5. CATALOGUE
// =============================================================================

model Category {
  id            String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String    @db.Uuid
  name          String
  description   String?
  color         String    @default("#888888")
  parentId      String?   @db.Uuid
  imageUploadId String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  image     Upload?    @relation("CategoryImage", fields: [imageUploadId], references: [id])
  products  Product[]
  inventories InventoryCount[]
  moderationItems ModerationItem[]
  moderationRules ModerationRule[]

  // PARTIAL UNIQUE: (workspaceId, name) WHERE deletedAt IS NULL
  @@index([workspaceId, parentId])
}

model Unit {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId  String?  @db.Uuid
  name         String
  abbreviation String
  isSystem     Boolean  @default(false)
  containsQty  Int?
  baseUnitId   String?  @db.Uuid
  createdAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  baseUnit  Unit?      @relation("UnitBase", fields: [baseUnitId], references: [id])
  derived   Unit[]     @relation("UnitBase")
  products  Product[]

  @@index([workspaceId])
}

model Product {
  id               String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId      String                  @db.Uuid
  sku              String
  name             String
  description      String?
  categoryId       String?                 @db.Uuid
  unitId           String?                 @db.Uuid
  trackStock       Boolean                 @default(true)
  price            Int
  oldPrice         Int?
  costPrice        Int?
  stock            Int?
  minStock         Int                     @default(0)
  weightGrams      Int?
  keywords         String[]                @default([])
  hasVariants      Boolean                 @default(false)
  isActive         Boolean                 @default(true)
  moderationStatus ModerationStatusProduct @default(not_required) // D36
  moderationItemId String?                 @unique @db.Uuid
  approvedSnapshot Json?
  contentVersion   Int                     @default(1)
  createdById      String?                 @db.Uuid
  lastInventoryAt  DateTime?
  version          Int                     @default(1)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category        Category?            @relation(fields: [categoryId], references: [id])
  unit            Unit?                @relation(fields: [unitId], references: [id])
  createdBy       User?                @relation("ProductCreatedBy", fields: [createdById], references: [id])
  currentModeration ModerationItem?    @relation("ProductCurrentModeration", fields: [moderationItemId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  expenses        ProductExpense[]
  recommendations Recommendation[]     @relation("RecoProduct")
  recommendedIn   Recommendation[]     @relation("RecoRecommended")
  movements       StockMovement[]
  agentProducts   AgentProduct[]
  orderItems      OrderItem[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  inventoryLines  InventoryCountLine[]
  stockRecos      StockRecommendation[]
  stockRecoMutes  StockRecommendationMute[]
  moderationItems ModerationItem[]     @relation("ProductModerationItems")
  reports         Report[]

  // PARTIAL UNIQUE: (workspaceId, sku) WHERE deletedAt IS NULL  (shared with ProductVariant.sku)
  // GIN trigram index on (name, description, array_to_string(keywords))
  @@index([workspaceId, isActive])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, moderationStatus])
}

model ProductImage {
  id             String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId      String               @db.Uuid
  storageKey     String
  url            String
  width          Int
  height         Int
  sortOrder      Int                  @default(0)
  isPrimary      Boolean              @default(false)
  aiCaption      String?
  altText        String?
  moderationFlag ImageModerationFlag?
  createdAt      DateTime             @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String    @db.Uuid // denormalised from Product: tenant scoping + partial unique (workspaceId, sku)
  productId   String    @db.Uuid
  name       String
  sku        String?
  attributes Json      @default("{}")
  price      Int
  costPrice  Int?
  stock      Int       @default(0)
  minStock   Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements      StockMovement[]
  orderItems     OrderItem[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  inventoryLines InventoryCountLine[]
  stockRecos     StockRecommendation[]

  @@unique([productId, name])
  @@index([workspaceId])
  // PARTIAL UNIQUE: (workspaceId, sku) WHERE deletedAt IS NULL AND sku IS NOT NULL
}

model ProductExpense {
  id          String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String          @db.Uuid
  productId   String          @db.Uuid
  category    ExpenseCategory
  description String?
  amount      Int
  isPerUnit   Boolean         @default(false)
  date        DateTime        @default(now())
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([workspaceId, productId])
}

model Recommendation {
  id            String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String               @db.Uuid
  productId     String               @db.Uuid
  recommendedId String               @db.Uuid
  type          RecommendationType
  score         Int                  @default(50)
  reason        String?
  source        RecommendationSource @default(manual)
  impressions   Int                  @default(0)
  conversions   Int                  @default(0)
  revenue       Int                  @default(0)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product               @relation("RecoProduct", fields: [productId], references: [id], onDelete: Cascade)
  recommended Product               @relation("RecoRecommended", fields: [recommendedId], references: [id], onDelete: Cascade)
  events      RecommendationEvent[]

  @@unique([productId, recommendedId, type])
  @@index([workspaceId, isActive])
}

model RecommendationEvent {
  id               String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  recommendationId String                  @db.Uuid
  conversationId   String                  @db.Uuid
  kind             RecommendationEventKind
  orderId          String?                 @db.Uuid
  at               DateTime                @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  order          Order?         @relation(fields: [orderId], references: [id])

  @@index([recommendationId, at])
}

model StockMovement {
  id                   String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId          String           @db.Uuid
  productId            String           @db.Uuid
  variantId            String?          @db.Uuid
  type                 MovementType
  quantity             Int
  quantityBefore       Int
  quantityAfter        Int
  reason               MovementReason?
  note                 String?
  refType              MovementRefType?
  refId                String?          @db.Uuid
  actorId              String?          @db.Uuid
  reversedByMovementId String?          @unique @db.Uuid
  createdAt            DateTime         @default(now())

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  actor      User?           @relation("MovementActor", fields: [actorId], references: [id])
  reversedBy StockMovement?  @relation("MovementReversal", fields: [reversedByMovementId], references: [id])
  reverses   StockMovement?  @relation("MovementReversal")
  inventoryLine InventoryCountLine?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, productId, createdAt])
  @@index([refType, refId])
}

model InventoryCount {
  id                String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String          @db.Uuid
  number            String
  scope             InventoryScope
  categoryId        String?         @db.Uuid
  status            InventoryStatus @default(draft)
  blockCounterSales Boolean         @default(false)
  startedById       String          @db.Uuid
  startedAt         DateTime        @default(now())
  validatedById     String?         @db.Uuid
  validatedAt       DateTime?
  lineCount         Int             @default(0)
  discrepancyCount  Int             @default(0)
  discrepancyValue  Int             @default(0)
  note              String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    Category?            @relation(fields: [categoryId], references: [id])
  startedBy   User                 @relation("InventoryStartedBy", fields: [startedById], references: [id])
  validatedBy User?                @relation("InventoryValidatedBy", fields: [validatedById], references: [id])
  lines       InventoryCountLine[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

model InventoryCountLine {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  inventoryCountId String   @db.Uuid
  productId        String   @db.Uuid
  variantId        String?  @db.Uuid
  expectedQty      Int
  countedQty       Int?
  difference       Int      @default(0)
  differencePct    Int      @default(0)
  note             String?
  movementId       String?  @unique @db.Uuid

  inventory InventoryCount  @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  movement  StockMovement?  @relation(fields: [movementId], references: [id])

  @@unique([inventoryCountId, productId, variantId])
}

/// GDS-10 rule-based recommendations (distinct from cross-sell Recommendation)
model StockRecommendation {
  id              String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId     String          @db.Uuid
  type            StockRecoType
  priority        Priority3
  status          StockRecoStatus @default(active)
  productId       String?         @db.Uuid
  variantId       String?         @db.Uuid
  supplierId      String?         @db.Uuid
  agentId         String?         @db.Uuid
  title           Json
  body            Json
  suggestedAction Json
  ruleKey         String
  estimatedValue  Int?
  generatedAt     DateTime        @default(now())
  jobId           String?         @db.Uuid
  snoozedUntil    DateTime?
  appliedAt       DateTime?
  appliedRefType  String?
  appliedRefId    String?         @db.Uuid
  dismissedAt     DateTime?
  dismissedById   String?         @db.Uuid

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  agent       Agent?          @relation(fields: [agentId], references: [id])
  job         Job?            @relation(fields: [jobId], references: [id])
  dismissedBy User?           @relation("StockRecoDismissedBy", fields: [dismissedById], references: [id])

  @@index([workspaceId, status, priority])
}

model StockRecommendationMute {
  workspaceId String        @db.Uuid
  productId   String        @db.Uuid
  type        StockRecoType

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([workspaceId, productId, type])
}

// =============================================================================
// 6. CUSTOMERS
