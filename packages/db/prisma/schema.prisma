model CashClosing {
  id                 String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId        String    @db.Uuid
  day                DateTime  @db.Date
  theoreticalBalance Int
  countedBalance     Int
  difference         Int
  note               String?
  closedById         String    @db.Uuid
  closedAt           DateTime  @default(now())
  reopenedById       String?   @db.Uuid
  reopenedAt         DateTime?

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  closedBy     User              @relation("CashClosedBy", fields: [closedById], references: [id])
  reopenedBy   User?             @relation("CashReopenedBy", fields: [reopenedById], references: [id])
  transactions CashTransaction[]

  @@unique([workspaceId, day])
}

