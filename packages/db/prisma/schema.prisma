model User {
  id               String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email            String       @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  locale           Locale       @default(fr)
  avatarUrl        String?
  emailVerifiedAt  DateTime?
  totpSecret       Bytes?
  totpEnabled      Boolean      @default(false)
  recoveryCodes    Json?
  platformRole     PlatformRole @default(none) // D41
  status           UserStatus   @default(active)
  blockedAt        DateTime?
  blockReason      String?
  ownedWorkspaceId String?      @unique @db.Uuid
  lastWorkspaceId  String?      @db.Uuid // last workspace used with an explicit X-Workspace-Id (api-contract §1.2); no FK on purpose
  prefs            Json         @default("{}") // { listDensity, soundOnMessage, dismissedAnnouncementIds[] }
  lastLoginAt      DateTime?
  lastSeenPlatform DevicePlatform?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  ownedWorkspace        Workspace?              @relation("WorkspaceOwner", fields: [ownedWorkspaceId], references: [id])
  refreshTokens         RefreshToken[]
  emailTokens           EmailToken[]
  memberships           Membership[]
  invitationsSent       Invitation[]            @relation("InvitationInviter")
  deviceTokens          DeviceToken[]
  legalAcceptances      LegalAcceptance[]
  platformInvitesSent   PlatformInvitation[]    @relation("PlatformInviteInviter")
  savedViews            SavedView[]
  reportSchedules       ReportSchedule[]        @relation("ReportScheduleCreator")
  sharedViews           SavedView[]             @relation("SavedViewSharedBy")
  notifications         Notification[]
  uploads               Upload[]
  apiKeysCreated        ApiKey[]
  webhooksCreated       WebhookEndpoint[]
  jobsCreated           Job[]
  channelsConnected     Channel[]               @relation("ChannelConnectedBy")
  conversationsAssigned Conversation[]          @relation("ConversationAssignee")
  messagesAuthored      Message[]               @relation("MessageAuthorUser")
  conversationNotes     ConversationNote[]
  insightsResolved      AgentInsight[]          @relation("InsightResolvedBy")
  agentVersions         AgentVersion[]          @relation("AgentVersionCreatedBy")
  agentTestLinks        AgentTestLink[]
  productsCreated       Product[]               @relation("ProductCreatedBy")
  productExpenses       ProductExpense[]
  stockMovements        StockMovement[]         @relation("MovementActor")
  inventoriesStarted    InventoryCount[]        @relation("InventoryStartedBy")
  inventoriesValidated  InventoryCount[]        @relation("InventoryValidatedBy")
  stockRecosDismissed   StockRecommendation[]   @relation("StockRecoDismissedBy")
  ordersCreated         Order[]                 @relation("OrderCreatedBy")
  ordersAssigned        Order[]                 @relation("OrderAssignee")
  orderCalls            OrderCall[]
  orderNotes            OrderNote[]
  paymentEntries        PaymentEntry[]
  shipmentEvents        ShipmentEvent[]
  purchasesCreated      Purchase[]
  salesCreated          Sale[]
  cashTransactions      CashTransaction[]       @relation("CashCreatedBy")
  cashClosings          CashClosing[]           @relation("CashClosedBy")
  cashReopenings        CashClosing[]           @relation("CashReopenedBy")
  billingPaymentsRec    BillingPayment[]        @relation("BillingPaymentRecordedBy")
  creditGrants          CreditLedger[]          @relation("CreditGrantedBy")
  packPurchases         CreditPackPurchase[]
  promoRedemptions      PromoRedemption[]
  promoCodesCreated     PromoCode[]
  planVersions          PlanVersion[]
  presetVersionsPub     AgentPresetVersion[]
  aiRoutesUpdated       AiRoute[]
  creditPricings        CreditPricing[]
  moderationAssigned    ModerationItem[]        @relation("ModerationAssignee")
  moderationReviewed    ModerationItem[]        @relation("ModerationReviewer")
  appealsSubmitted      ModerationAppeal[]      @relation("AppealSubmittedBy")
  appealsReviewed       ModerationAppeal[]      @relation("AppealReviewer")
  moderationRules       ModerationRule[]
  reportsFiled          Report[]                @relation("ReportReporter")
  reportsAssigned       Report[]                @relation("ReportAssignee")
  reportsResolved       Report[]                @relation("ReportResolvedBy")
  blocksCreated         CustomerBlock[]         @relation("BlockCreatedBy")
  blocksLifted          CustomerBlock[]         @relation("BlockLiftedBy")
  blacklistCreated      PlatformBlacklist[]     @relation("BlacklistCreatedBy")
  blacklistRevoked      PlatformBlacklist[]     @relation("BlacklistRevokedBy")
  blockedWords          BlockedWord[]
  ticketsOpened         SupportTicket[]         @relation("TicketUser")
  ticketsAssigned       SupportTicket[]         @relation("TicketAssignee")
  ticketMessages        SupportMessage[]
  cannedReplies         CannedReply[]
  deletionRequests      AccountDeletionRequest[] @relation("DeletionUser")
  deletionsProcessed    AccountDeletionRequest[] @relation("DeletionProcessedBy")
  impersonations        ImpersonationSession[]
  auditLogs             AuditLog[]
  appVersionsUpdated    AppVersion[]
  featureFlagsUpdated   FeatureFlag[]
  legalDocsPublished    LegalDocument[]
  settingsUpdated       PlatformSetting[]
  settingVersions       PlatformSettingVersion[]
  incidentsCreated      Incident[]
  incidentUpdates       IncidentUpdate[]
  cmsEntriesCreated     CmsEntry[]
  cmsLocalesUpdated     CmsEntryLocale[]
  cmsVersions           CmsEntryVersion[]
  channelEvents         ChannelEvent[]
  salesCancelled        Sale[]                  @relation("SaleCancelledBy")
  workspaceTrustChanges Workspace[]             @relation("WorkspaceTrustSetBy")

  @@index([platformRole])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model EmailToken {
  id        String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String         @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique
  payload   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Workspace {
  id                     String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name                   String
  slug                   String          @unique
  logoUrl                String?
  phone                  String?
  address                String?
  senderWilayaId         Int?
  locale                 Locale          @default(fr)
  timezone               String          @default("Africa/Algiers")
  stockMode              StockMode       @default(simple)
  onboardingStep         Int             @default(0)
  freeDeliveryThreshold  Int?
  autoPauseOnManualReply Boolean         @default(true)
  handoffReminderMin     Int             @default(30)
  onlinePaymentEnabled   Boolean         @default(false)
  autoSendToCourier      Boolean         @default(false)
  defaultCourierAccountId String?        @unique @db.Uuid
  targetMarginPct        Int             @default(35)
  systemMessages         Json            @default("{}") // {handoff, out_of_hours, out_of_stock, welcome} x {fr,ar,en} (D43); seeded at creation
  status                 WorkspaceStatus @default(active)
  suspendedAt            DateTime?
  suspendReason          SuspendReason?
  suspendNote            String?
  deletionScheduledAt    DateTime?
  trustLevel             TrustLevel      @default(new) // D36, D52
  trustSetById           String?         @db.Uuid
  safetyRules            Json            @default("{\"riskAfterReturns\":2,\"autoBlockEnabled\":false,\"autoBlockAfterUncollected\":3,\"handoffOnRisk\":true}") // D37 — autoBlockEnabled: the auto-block rule is OFF by default (04 §13); autoBlockAfterUncollected = its threshold
