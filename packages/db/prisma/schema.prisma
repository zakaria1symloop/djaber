model WebhookDelivery {
  id            String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  endpointId    String                @db.Uuid
  event         String
  payload       Json
  attempt       Int                   @default(1)
  status        WebhookDeliveryStatus @default(pending)
  responseCode  Int?
  durationMs    Int?
  error         String?
  nextAttemptAt DateTime?
  replayOfId    String?               @db.Uuid
  createdAt     DateTime              @default(now())

  endpoint WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  replayOf WebhookDelivery?  @relation("DeliveryReplay", fields: [replayOfId], references: [id])
  replays  WebhookDelivery[] @relation("DeliveryReplay")

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
}

model Outbox {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String?   @db.Uuid
  topic       String
  key         String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([topic, key]) // dedup: OutboxService.enqueue uses ON CONFLICT DO NOTHING
  @@index([processedAt, createdAt])
}

/// Analytics daily rollup (ANA-02, M8) — recomputed by `sched-daily-stats`; never incremented
model DailyStat {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String   @db.Uuid
  day         DateTime @db.Date
  metrics     Json     // { conversations, aiReplies, handoffs, orders, revenue, credits, byChannel, byAgent, byWilaya }
  computedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, day])
}

/// Scheduled monthly report e-mail (D62, plan feature `scheduled_reports`)
model ReportSchedule {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String   @db.Uuid
  reportKey   String
  email       String
  dayOfMonth  Int      @default(1)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ReportScheduleCreator", fields: [createdById], references: [id])

  @@unique([workspaceId, reportKey, email])
}

model Job {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId    String?   @db.Uuid
  kind           JobKind
  queue          String?
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  total          Int?
  payload        Json?
  result         Json?
  error          String?
  resultUploadId String?   @db.Uuid
  expiresAt      DateTime?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace    Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?                 @relation(fields: [createdById], references: [id])
  resultUpload Upload?               @relation("JobResultUpload", fields: [resultUploadId], references: [id])
  importedOrders Order[]             @relation("OrderImportJob")
  stockRecos   StockRecommendation[]
  deletionExports AccountDeletionRequest[]

  @@index([workspaceId, kind, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id                     String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId            String?   @db.Uuid
  actorType              ActorType
  actorId                String?   @db.Uuid
  actorRole              String?
  action                 String
  entity                 String
  entityId               String?
  before                 Json?
  after                  Json?
  diff                   Json?
  reason                 String?
  impersonationSessionId String?   @db.Uuid
  ip                     String?
  userAgent              String?
  sessionId              String?
  at                     DateTime  @default(now())

  actor         User?                 @relation(fields: [actorId], references: [id])
  impersonation ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id])

  @@index([workspaceId, at])
  @@index([actorId, at])
  @@index([action, at])
  @@index([entity, entityId])
}

model Counter {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String? @db.Uuid
  key         String
  value       Int     @default(0)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

/// D42
model SavedView {
  id          String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String        @db.Uuid
