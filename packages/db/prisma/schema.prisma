model ModerationItem {
  id                String               @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String               @db.Uuid
  type              ModerationItemType
  productId         String?              @db.Uuid
  agentId           String?              @db.Uuid
  categoryId        String?              @db.Uuid
  contentVersion    Int                  @default(1)
  snapshot          Json
  status            ModerationItemStatus @default(pending)
  aiScore           Decimal?             @db.Decimal(3, 2)
  aiFlags           Json                 @default("[]")
  priority          ModerationPriority   @default(normal)
  slaDueAt          DateTime
  assigneeId        String?              @db.Uuid
  reviewerId        String?              @db.Uuid
  decision          ModerationDecision?
  reasonTemplateKey String?
  merchantMessage   String?
  rejectedFields    String[]             @default([])
  decidedAt         DateTime?
  submittedAt       DateTime             @default(now())
  source            ModerationSource     @default(create)

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product?          @relation("ProductModerationItems", fields: [productId], references: [id], onDelete: Cascade)
  currentOf Product?          @relation("ProductCurrentModeration")
  agent     Agent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignee  User?             @relation("ModerationAssignee", fields: [assigneeId], references: [id])
  reviewer  User?             @relation("ModerationReviewer", fields: [reviewerId], references: [id])
  appeal    ModerationAppeal?

  @@unique([productId, contentVersion])
  @@index([status, priority, submittedAt])
  @@index([workspaceId, productId, submittedAt])
}

model ModerationAppeal {
  id                 String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId        String          @db.Uuid
  moderationItemId   String          @unique @db.Uuid
  message            String
  attachmentUploadId String?         @db.Uuid
  submittedById      String          @db.Uuid
  submittedAt        DateTime        @default(now())
  deadlineAt         DateTime
  reviewerId         String?         @db.Uuid
  decision           AppealDecision?
  decisionNote       String?
  decidedAt          DateTime?

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item        ModerationItem @relation(fields: [moderationItemId], references: [id], onDelete: Cascade)
  attachment  Upload?        @relation(fields: [attachmentUploadId], references: [id])
  submittedBy User           @relation("AppealSubmittedBy", fields: [submittedById], references: [id])
  reviewer    User?          @relation("AppealReviewer", fields: [reviewerId], references: [id])
}

model ModerationRule {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key            String             @unique
  kind           ModerationRuleKind
  value          String
  locale         Locale?
  categoryId     String?            @db.Uuid
  referencePrice Int?
  isActive       Boolean            @default(true)
  createdById    String             @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  category  Category? @relation(fields: [categoryId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
}

// =============================================================================
// 12. TRUST & SAFETY (D37)
