model Report {
  id                String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String?         @db.Uuid
  type              ReportType
  reporterKind      ReporterKind
  reporterUserId    String?         @db.Uuid
  reporterEmail     String?
  conversationId    String?         @db.Uuid
  clientId          String?         @db.Uuid
  messageId         String?         @db.Uuid
  aiRunId           String?         @db.Uuid
  productId         String?         @db.Uuid
  targetWorkspaceId String?         @db.Uuid
  reason            ReportReason
  details           String?
  excerpt           Json?
  severity          Severity        @default(medium)
  status            ReportStatus    @default(open)
  assigneeId        String?         @db.Uuid
  decision          ReportDecision?
  decisionNote      String?
  resolvedById      String?         @db.Uuid
  resolvedAt        DateTime?
  reporterNotifiedAt DateTime?
  blockRequested    Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workspace       Workspace?    @relation("ReportWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  targetWorkspace Workspace?    @relation("ReportTargetWorkspace", fields: [targetWorkspaceId], references: [id])
  reporter        User?         @relation("ReportReporter", fields: [reporterUserId], references: [id])
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  client          Client?       @relation(fields: [clientId], references: [id])
  message         Message?      @relation(fields: [messageId], references: [id])
  aiRun           AiRun?        @relation(fields: [aiRunId], references: [id])
  product         Product?      @relation(fields: [productId], references: [id])
  assignee        User?         @relation("ReportAssignee", fields: [assigneeId], references: [id])
  resolvedBy      User?         @relation("ReportResolvedBy", fields: [resolvedById], references: [id])
  blocks          CustomerBlock[]
  blacklistRows   PlatformBlacklist[]

  @@index([status, severity, createdAt])
  @@index([workspaceId, createdAt])
}

model CustomerBlock {
  id               String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId      String       @db.Uuid
  clientId         String?      @db.Uuid
  phone            String?
  channelId        String?      @db.Uuid
  externalSenderId String?
  reason           BlockReason?
  note             String?
  source           BlockSource  @default(manual)
  reportId         String?      @db.Uuid
  blockedById      String?      @db.Uuid
  blockedAt        DateTime     @default(now())
  unblockedById    String?      @db.Uuid
  unblockedAt      DateTime?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     Client?   @relation(fields: [clientId], references: [id])
  channel    Channel?  @relation(fields: [channelId], references: [id])
  report     Report?   @relation(fields: [reportId], references: [id])
  blockedBy  User?     @relation("BlockCreatedBy", fields: [blockedById], references: [id])
  unblockedBy User?    @relation("BlockLiftedBy", fields: [unblockedById], references: [id])

  // PARTIAL UNIQUE: (workspaceId, clientId) WHERE unblockedAt IS NULL
  @@index([workspaceId, unblockedAt])
  @@index([phone])
}

model PlatformBlacklist {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  phone          String    @unique
  reason         String
  reportId       String?   @db.Uuid
  workspaceCount Int       @default(0)
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  revokedById    String?   @db.Uuid
  revokedAt      DateTime?

  report    Report? @relation(fields: [reportId], references: [id])
  createdBy User    @relation("BlacklistCreatedBy", fields: [createdById], references: [id])
  revokedBy User?   @relation("BlacklistRevokedBy", fields: [revokedById], references: [id])
}

model BlockedWord {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String?  @db.Uuid
  word        String
  locale      Locale?
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id])

  @@unique([workspaceId, word])
}

