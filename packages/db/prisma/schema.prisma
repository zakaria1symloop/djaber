model SaleItem {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  saleId      String  @db.Uuid
  productId   String  @db.Uuid
  variantId   String? @db.Uuid
  productName String
  variantName String?
  quantity    Int
  unitPrice   Int
  costPrice   Int?
  discount    Int     @default(0)
  total       Int

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
}

model CashTransaction {
  id                   String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId          String          @db.Uuid
  type                 CashType
  amount               Int
  category             CashCategory
  method               CashMethod      @default(cash)
  reference            String?
  description          String?
  date                 DateTime        @default(now())
  isAutomatic          Boolean         @default(false)
  sourceType           CashSourceType?
  sourceId             String?         @db.Uuid
  closingId            String?         @db.Uuid
  createdById          String?         @db.Uuid
  proofUploadId        String?         @db.Uuid
  correctsTransactionId String?        @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  closing      CashClosing?      @relation(fields: [closingId], references: [id])
  createdBy    User?             @relation("CashCreatedBy", fields: [createdById], references: [id])
  proof        Upload?           @relation("CashProof", fields: [proofUploadId], references: [id])
  corrects     CashTransaction?  @relation("CashCorrection", fields: [correctsTransactionId], references: [id])
  correctedBy  CashTransaction[] @relation("CashCorrection")
  paymentEntry PaymentEntry?

  @@index([workspaceId, date])
  @@index([sourceType, sourceId])
