# Copy to .env (git-ignored). Never commit real values. Empty value => the fake adapter is used.
NODE_ENV=development
PORT=4010
DATABASE_URL=postgresql://djaber:djaber@localhost:54329/djaber
REDIS_URL=redis://127.0.0.1:63799
PUBLIC_API_URL=http://localhost:4010
PUBLIC_WEB_URL=http://localhost:3010
WEB_ORIGINS=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:4010
# Web server only (M11 public pages rendered on the server): address the Next server uses to reach the API when it
# differs from the browser's NEXT_PUBLIC_API_URL (private network / container name). Empty = NEXT_PUBLIC_API_URL.
# The web also reads PUBLIC_WEB_URL (canonical URLs, hreflang, sitemap).
API_INTERNAL_URL=
# ADM-14 "Ouvrir le monitoring (Grafana)" (empty = button greyed)
NEXT_PUBLIC_MONITORING_URL=
# Public pages "Contact" (visitors have no session for /help/contact): mailto address (empty = support@djaber.ai)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Auth / crypto (generated under .local/keys in dev when empty; required in staging/production)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Web and API on two different sites (e.g. Vercel + VPS host): refresh cookie SameSite=None; Secure; Partitioned
REFRESH_COOKIE_CROSS_SITE=false
ENCRYPTION_KEYS=

# Storage: local | s3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Mail: file | resend
MAIL_DRIVER=file
# MAIL_DRIVER=smtp: the server's own mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Djaber <no-reply@djaber.ai>
RESEND_API_KEY=

# SMS (dunning reminders, PlatformProvider sms): fake writes to SMS_LOCAL_DIR; no live SMS driver exists yet
SMS_DRIVER=fake
SMS_LOCAL_DIR=.local/sms

# Meta (Messenger / Instagram): fake | graph. Keep `fake` on a developer machine.
META_DRIVER=fake
# Guard: with META_DRIVER=graph the real Graph API adapter refuses to start in development / test unless this is true
META_ALLOW_LIVE=false
# V1 → V2 cutover on the same host: answer the V1 paths registered in Meta (webhook, OAuth return, data deletion)
META_LEGACY_PATHS=false
# Facebook Login permissions (comma list) if the Meta app has fewer than the full list; empty = full list
META_FACEBOOK_SCOPES=
META_OAUTH_CALLBACK_PATH=/api/v1/channels/callback/{platform}
META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Payments (Chargily Pay): fake | chargily
PAYMENT_DRIVER=fake
# Guard: with PAYMENT_DRIVER=chargily the gateway refuses to start in development / test unless this is true (never a real payment from dev)
PAYMENT_ALLOW_LIVE=false
CHARGILY_MODE=test
CHARGILY_API_KEY=
CHARGILY_SECRET=

# AI: fake | live
AI_DRIVER=fake
# safety guard: AI_DRIVER=live is refused in development / test unless this is true
AI_ALLOW_LIVE=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Couriers: fake | live (merchant credentials are stored encrypted per workspace)
COURIER_DRIVER=fake
# Guard: with COURIER_DRIVER=live the courier adapters refuse to start in development / test unless this is true
COURIER_ALLOW_LIVE=false
# Per courier account limiter (requests / second): parcel creation, tracking batches
COURIER_SEND_RPS=5
COURIER_TRACK_RPS=2

# Google Sheets / OAuth: fake | google
SHEETS_DRIVER=fake
# Guard: with SHEETS_DRIVER=google the Google OAuth / Sheets driver refuses to start in development / test unless this is true
SHEETS_ALLOW_LIVE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth app verified (false = "testing" status: Sheets card shows the "≤ 100 utilisateurs test" notice)
GOOGLE_OAUTH_VERIFIED=false
# Google Picker (sheet chooser): developer key + Cloud project number
GOOGLE_PICKER_KEY=
GOOGLE_PICKER_APP_ID=

# Outbound merchant webhooks: in development / test only local / LAN receivers are called unless this is true
WEBHOOKS_ALLOW_LIVE=false

# Captcha of the public forms ("Signaler ce vendeur"): none | fake (token fake-pass) | turnstile
CAPTCHA_DRIVER=fake
# Guard: CAPTCHA_DRIVER=turnstile is refused in development / test unless this is true
CAPTCHA_ALLOW_LIVE=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Push / in-app purchases: fake | fcm, fake | stores
PUSH_DRIVER=fake
# Guard: with PUSH_DRIVER=fcm the FCM adapter refuses to start in development / test unless this is true
PUSH_ALLOW_LIVE=false
FCM_SERVICE_ACCOUNT=
IAP_DRIVER=fake
# Guard: with IAP_DRIVER=stores the Google Play / App Store validators refuse to start in development / test unless this is true
IAP_ALLOW_LIVE=false
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_PACKAGE_NAME=ai.djaber.app
GOOGLE_PLAY_PUBSUB_TOKEN=
APP_STORE_SHARED_SECRET=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=ai.djaber.app
APPLE_IAP_ENV=sandbox

# Prometheus /metrics (API + worker): internal network only; when set, the scrape needs "Authorization: Bearer <token>"
METRICS_TOKEN=

LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@djaber.local
SEED_ADMIN_PASSWORD=
